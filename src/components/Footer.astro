---
import site from '../data/site.json';
const { phone, email } = site.contact;
const telHref = `tel:${phone.replace(/\s+/g, '')}`;
const mailHref = `mailto:${email}`;

const year = new Date().getFullYear();

const linkClasses =
  'rounded-sm transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<footer class="bg-stone-900 py-12 text-stone-300">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-lg font-semibold text-white">{site.businessName}</p>
        <p class="mt-1 text-sm">{site.tagline}</p>
      </div>

      <div class="space-y-1 text-sm">
        <p><a href={telHref} class={linkClasses}>{phone}</a></p>
        <p><a href={mailHref} class:list={[linkClasses, 'break-all']}>{email}</a></p>
      </div>
    </div>

    <p class="mt-8 text-center text-xs text-stone-500 md:text-left">
      &copy; {year} {site.businessName}. All rights reserved.
    </p>
  </div>
</footer>
