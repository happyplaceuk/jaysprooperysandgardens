---
import site from '../data/site.json';
const { headline, subtext } = site.hero;
const { phone, email } = site.contact;
const telHref = `tel:${phone.replace(/\s+/g, '')}`;
const mailHref = `mailto:${email}`;

const linkClasses =
  'font-medium transition-colors hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm';
---

<section id="home" class="bg-green-900 text-white">
  <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:px-8">
    <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">{headline}</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-green-50">{subtext}</p>
    <p class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-green-50">
      <a href={telHref} class={linkClasses}>{phone}</a>
      <a href={mailHref} class:list={[linkClasses, 'break-all']}>{email}</a>
    </p>
  </div>
</section>
