---
import site from '../data/site.json';

const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#services', label: 'Services' },
  { href: '#gallery', label: 'Gallery' },
];
---

<!-- No JS menu toggle: nav links simply wrap onto a new line on small screens. -->
<header class="sticky top-0 z-50 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a
        href="#home"
        class="rounded-sm text-xl font-bold tracking-tight text-green-800 transition-colors hover:text-green-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
      >
        {site.businessName}
      </a>

      <nav aria-label="Primary" class="flex flex-wrap gap-x-6 gap-y-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-sm text-sm font-medium text-stone-600 transition-colors hover:text-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
