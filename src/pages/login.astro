---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

const hadError = Astro.url.searchParams.get('error') === '1';
---

<BaseLayout title="Log In | Jay's properties and gardens">
  <main class="mx-auto flex min-h-[70vh] max-w-sm flex-col justify-center px-4 py-16 sm:px-6">
    <h1 class="text-2xl font-bold tracking-tight text-stone-900">Log In</h1>
    <p class="mt-2 text-stone-600">Enter the password to upload gallery photos.</p>

    {hadError && (
      <p class="mt-4 rounded-md bg-red-50 px-4 py-3 text-sm font-medium text-red-800">
        Incorrect password. Please try again.
      </p>
    )}

    <form method="POST" action="/api/login" class="mt-6 space-y-4">
      <div>
        <label for="password" class="block text-sm font-medium text-stone-700">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autofocus
          class="mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700"
        />
      </div>

      <button
        type="submit"
        class="inline-block rounded-md bg-green-800 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-green-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
      >
        Log In
      </button>
    </form>
  </main>
</BaseLayout>
